{
  "run": {
    "seed": 0,
    "max_rounds": 2,
    "use_verifier": true,
    "outputs_dir": "${env:OUTPUTS_DIR,outputs/runs}"
  },
  "reader": {
    "enable_global": true,
    "validation_filter": true,
    "max_local_nodes": 400,
    "max_global_inline": null
  },
  "model": {
    "provider": "openai_compat",
    "base_url": "${env:MODEL_BASE_URL,https://openrouter.ai/api/v1}",
