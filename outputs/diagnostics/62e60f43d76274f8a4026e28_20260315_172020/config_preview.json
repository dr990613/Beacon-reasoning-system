    "model_name": "${env:MODEL_NAME,qwen/qwen3-32b}",
    "timeout_s": 120,
    "params": {
      "temperature": 0.2,
      "top_p": 0.95,
      "max_tokens": 2048
    }
  },
  "adapter": {
    "name": "smoke",
    "params": {
      "repo_root": ".",
      "target_file": null,
      "target_qualname": null,
      "spec": "",
      "run_cmd": "pytest -q",
      "work_dir": null
    }
